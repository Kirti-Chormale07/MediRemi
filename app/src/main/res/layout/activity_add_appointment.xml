<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/appt_editor_title"
            android:textColor="@color/on_surface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_appt_doctor" />

        <EditText
            android:id="@+id/edtApptDoctor"
            style="@style/BigField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_appt_doctor"
            android:inputType="textPersonName" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/lbl_appt_reason" />

        <EditText
            android:id="@+id/edtApptReason"
            style="@style/BigField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_appt_reason"
            android:inputType="text" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/lbl_appt_place" />

        <EditText
            android:id="@+id/edtApptPlace"
            style="@style/BigField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_appt_place"
            android:inputType="text" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_appt_when" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnApptDate"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnApptTime"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_appt_lead" />

        <Spinner
            android:id="@+id/spnApptLead"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAppt"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save_appt" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAppt"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/sos_red"
            android:text="@string/btn_delete_appt" />
    </LinearLayout>
</ScrollView>
